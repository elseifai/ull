# Local development values. On the server, deploy/docker-compose.yml overrides DATABASE_URL,
# and PAYLOAD_PUBLIC_SERVER_URL / NEXT_PUBLIC_SITE_URL become https://ullindia.com.
# Locally the website (cd ../web && npm run dev) runs on :4100 and the CMS on :3000.
# Local Postgres: `npm run db` (Docker), or Postgres.app / Homebrew with a ull_cms database.
DATABASE_URL=postgres://ull:ull@localhost:5432/ull_cms
PAYLOAD_SECRET=CHANGE_ME_long_random_string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:4100

# Publish → rebuild the static site (GitHub Actions workflow_dispatch URL or similar)
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=
DEPLOY_HOOK_BODY=

# Uploads. Leave S3_BUCKET blank locally to store files on disk.
# In AWS, CDN_HOST is the stage CDN hostname and the instance role supplies credentials.
S3_BUCKET=
CDN_HOST=
AWS_REGION=ap-south-1

# Messaging (leave blank to log messages instead of sending)
SES_REGION=ap-south-1
SES_FROM=
GUPSHUP_API_KEY=
GUPSHUP_SENDER=
WATI_API_URL=
WATI_TOKEN=

# First admin, used by `npm run seed`
SEED_ADMIN_EMAIL=admin@ullindia.com
SEED_ADMIN_PASSWORD=
