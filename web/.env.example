# Public URL of the site (canonical links, sitemap). Locally: http://localhost:4100
NEXT_PUBLIC_SITE_URL=https://ullindia.com
# Where forms post. "/api" when CloudFront routes /api/* to the CMS server. Locally: http://localhost:3000/api
NEXT_PUBLIC_API_URL=/api
# The CMS, for the page builder (/editor/) and live preview (/preview/). Blank = same domain. Locally: http://localhost:3000
NEXT_PUBLIC_CMS_URL=
# CMS to pull published pages from at build time. Leave blank to build from src/content files.
CMS_URL=https://ullindia.com
# Brand CDN. Leave blank locally so images stay on /assets/. Set per stage at build time.
NEXT_PUBLIC_CDN_URL=
